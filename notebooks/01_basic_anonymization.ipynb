 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# BERT-based Data Anonymization Experiments\n",
    "\n",
    "This notebook demonstrates the basic usage of the anonymization pipeline with both HF Transformers and SpaCy backends."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install dependencies (run once)\n",
    "!pip install -e .[dev]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic imports\n",
    "from anonymization import (\n",
    "    AnonymizationPipeline,\n",
    "    PipelineConfig,\n",
    "    Document,\n",
    "    ModelBackend,\n",
    "    AnonymizationStrategy,\n",
    "    AnonymizationConfig,\n",
    "    HFTransformersNER,\n",
    "    SpacyNER,\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sample texts for testing\n",
    "sample_texts = [\n",
    "    \"John Smith lives at 123 Main Street, New York. His email is john.smith@email.com and phone is +1-555-123-4567.\",\n",
    "    \"María García works at Google in Madrid. Contact: maria.garcia@google.com, DNI: 12345678Z.\",\n",
    "    \"The patient Mr. Robert Johnson (DOB: 1980-05-15) was admitted to Mayo Clinic on 2024-01-20.\",\n",
    "    \"Invoice #INV-2024-001 for Apple Inc. Amount: $15,000. IBAN: ES9121000418450200051332.\",\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configure HF Transformers pipeline\n",
    "hf_config = PipelineConfig(\n",
    "    model_backend=ModelBackend.HF_TRANSFORMERS,\n",
    "    model_name=\"dslim/bert-base-NER\",\n",
    "    confidence_threshold=0.7,\n",
    "    device=\"auto\",\n",
    "    anonymization=AnonymizationConfig(strategy=AnonymizationStrategy.MASK),\n",
    ")\n",
    "\n",
    "hf_pipeline = AnonymizationPipeline(hf_config)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Process documents with HF\n",
    "hf_docs = [Document(id=f\"doc-{i}\", text=t) for i, t in enumerate(sample_texts)]\n",
    "hf_results = hf_pipeline.run(hf_docs)\n",
    "\n",
    "for r in hf_results:\n",
    "    print(f\"=== {r.document.id} ===\")\n",
    "    print(f\"Original: {r.document.text}\")\n",
    "    print(f\"Anonymized: {r.document.anonymized_text}\")\n",
    "    print(f\"Entities: {len(r.document.entities)}\")\n",
    "    for e in r.document.entities:\n",
    "        print(f\"  - {e.text} ({e.label.value}: {e.score:.3f})\")\n",
    "    print()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configure SpaCy pipeline\n",
    "spacy_config = PipelineConfig(\n",
    "    model_backend=ModelBackend.SPACY,\n",
    "    spacy_model=\"en_core_web_trf\",\n",
    "    confidence_threshold=0.7,\n",
    "    anonymization=AnonymizationConfig(strategy=AnonymizationStrategy.REPLACE),\n",
    ")\n",
    "\n",
    "spacy_pipeline = AnonymizationPipeline(spacy_config)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Process with SpaCy\n",
    "spacy_docs = [Document(id=f\"doc-{i}\", text=t) for i, t in enumerate(sample_texts)]\n",
    "spacy_results = spacy_pipeline.run(spacy_docs)\n",
    "\n",
    "for r in spacy_results:\n",
    "    print(f\"=== {r.document.id} ===\")\n",
    "    print(f\"Original: {r.document.text}\")\n",
    "    print(f\"Anonymized: {r.document.anonymized_text}\")\n",
    "    print(f\"Entities: {len(r.document.entities)}\")\n",
    "    for e in r.document.entities:\n",
    "        print(f\"  - {e.text} ({e.label.value})\")\n",
    "    print()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compare strategies\n",
    "strategies = [\n",
    "    AnonymizationStrategy.MASK,\n",
    "    AnonymizationStrategy.REPLACE,\n",
    "    AnonymizationStrategy.HASH,\n",
    "    AnonymizationStrategy.REDACT,\n",
    "    AnonymizationStrategy.PSEUDONYMIZE,\n",
    "]\n",
    "\n",
    "test_text = \"John Doe (john@company.com) works at Acme Corp in London.\"\n",
    "\n",
    "for strategy in strategies:\n",
    "    config = PipelineConfig(\n",
    "        model_backend=ModelBackend.HF_TRANSFORMERS,\n",
    "        model_name=\"dslim/bert-base-NER\",\n    "    "    anonymization=AnonymizationConfig(strategy=strategy),\n",
    "    )\n",
    "    pipeline = AnonymizationPipeline(config)\n",
    "    doc = Document(id=\"test\", text=test_text)\n",
    "    result = pipeline.run([doc])[0]\n",
    "    print(f\"{strategy.value:15} -> {result.document.anonymized_text}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Streaming results\n",
    "config = PipelineConfig(model_backend=ModelBackend.HF_TRANSFORMERS)\n",
    "pipeline = AnonymizationPipeline(config)\n",
    "docs = [Document(id=f\"stream-{i}\", text=t) for i, t in enumerate(sample_texts)]\n",
    "\n",
    "for chunk in pipeline.run_stream(docs):\n",
    "    for node_name, state in chunk.items():\n",
    "        if node_name == \"collect_results\" and state.get(\"results\"):\n",
    "            for r in state[\"results\"]:\n",
    "                print(f\"Streamed: {r.document.id} - {r.entities_found} entities\")"
   ]
  }
 ],
